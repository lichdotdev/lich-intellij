<idea-plugin>
    <id>dev.lich.intellij</id>
    <name>lich</name>
    <vendor url="https://github.com/omartelo/lich">lich</vendor>

    <description><![CDATA[
        Send what you are looking at in the IDE to a <a href="https://github.com/omartelo/lich">lich</a>
        session.
        <ul>
            <li><b>Send selection to lich</b> pastes the selected code, with its file and line range,
                at the prompt of the session running on this project.</li>
            <li><b>Send file to lich</b> pastes the path of the current file, or of every file selected
                in the Project view.</li>
        </ul>
        Nothing is sent for you: the text lands at the prompt, ready for you to write the question
        around it and press Enter. Requires lich with <code>lich insert</code>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="dev.lich.intellij.LichSettings"/>
        <applicationConfigurable
            parentId="tools"
            instance="dev.lich.intellij.LichConfigurable"
            id="dev.lich.intellij.settings"
            displayName="lich"/>
        <notificationGroup id="lich" displayType="BALLOON"/>
        <statusBarWidgetFactory id="lich.sessions" implementation="dev.lich.intellij.LichStatusWidgetFactory"/>
        <intentionAction>
            <className>dev.lich.intellij.SendProblemIntention</className>
            <category>lich</category>
            <skipBeforeAfter>true</skipBeforeAfter>
        </intentionAction>
    </extensions>

    <actions>
        <action id="Lich.SendSelection"
                class="dev.lich.intellij.SendSelectionAction"
                icon="/icons/lich.svg"
                text="Send Selection to lich"
                description="Paste the selected code, with its file and lines, at the prompt of a lich session">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <!-- Unbound in the default keymap; rebind it in Settings › Keymap. -->
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift L"/>
        </action>
        <action id="Lich.SendFile"
                class="dev.lich.intellij.SendFileAction"
                icon="/icons/lich.svg"
                text="Send File to lich"
                description="Paste the path of the file, or of the selected files, at the prompt of a lich session">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Lich.SendTestFailure"
                class="dev.lich.intellij.SendTestFailureAction"
                icon="/icons/lich.svg"
                text="Send Failure to lich"
                description="Paste the failed tests, with their messages and traces, at the prompt of a lich session">
            <add-to-group group-id="TestTreePopupMenu" anchor="last"/>
        </action>
        <action id="Lich.SendProblem"
                class="dev.lich.intellij.SendProblemNodeAction"
                icon="/icons/lich.svg"
                text="Send Problem to lich"
                description="Paste the problem, with the line it is on, at the prompt of a lich session">
            <add-to-group group-id="ProblemsView.ToolWindow.TreePopup" anchor="last"/>
        </action>
        <action id="Lich.SendChanges"
                class="dev.lich.intellij.SendChangesAction"
                icon="/icons/lich.svg"
                text="Send Changes to lich"
                description="Paste the diff of the selected changes at the prompt of a lich session">
            <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
        </action>
        <group id="Lich.EditorPopup">
            <separator/>
            <reference ref="Lich.SendSelection"/>
            <reference ref="Lich.SendFile"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
